# ============================================
# REKWIZYTOR - Environment Variables
# ============================================
# Last updated: 
# ============================================

NEXT_PUBLIC_ENABLE_EXPERIMENTAL_MAPPING=false

# --------------------------------------------
# AI SERVICES
# --------------------------------------------
# Text & vision generation (utils/ai/client.ts):
# OPENROUTER_API_KEY takes precedence; otherwise OPENAI_API_KEY is used.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Optional model overrides (comma-separated list = fallbacks on OpenRouter)
# AI_MODEL_VISION=google/gemini-3.5-flash-lite,openai/gpt-6-luna
# AI_MODEL_TEXT=google/gemini-3.5-flash-lite

# Text embeddings for hybrid search (stored vectors are text-embedding-004)
GEMINI_API_KEY=

# --------------------------------------------
# DATABASE - Supabase
# --------------------------------------------
# Main database connection
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=