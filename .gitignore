# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


# learning & notes
LEARNING.md

# admin tools (local only)
/components/admin/
app/*/admin/

# keys and certificates (never commit)
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
id_ecdsa*

# Claude Code (local)
.claude/settings.local.json
.claude/worktrees/

# experiments: data exports, vectors, test results
test_data_export*.json
migration_chunk_*
migration_vectors.sql
.supabase_temp_*
keyword-count-results.json
query_analysis.txt
*_backup.sql
*_dump.sql
*.sqlite
*.db

# experiment tools (local data)
pocketbase_data/
pocketbase_public/
wandb/
ollama_data/

# temporary files
*.tmp
*.temp
